Options -Indexes -MultiViews

# ----------------------------------------------------------------------
# | MIME Types (Apache mod_mime for cPanel / LiteSpeed / Apache)       |
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType application/json .json .ld+json
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType image/webp .webp
    AddType image/avif .avif
    AddType application/manifest+json .webmanifest
    RemoveType .gz
    AddEncoding gzip .gz
</IfModule>

<IfModule mod_dir.c>
    DirectorySlash Off
    DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Block invalid /undefined/ crawl paths immediately (HTTP 404)
RewriteRule (^|/)undefined(/|$) - [R=404,L]

# 1b. Never serve sitemap.xml with a trailing slash (GSC "Couldn't fetch")
RewriteRule ^sitemap\.xml/$ /sitemap.xml [R=301,L,NC]

# 2. Canonical Host & Protocol (HTTPS + Non-WWW) for production
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.aia\.in\.net$ [NC]
RewriteRule ^ https://aia.in.net%{REQUEST_URI} [R=301,L]

# 2b. Fully Dynamic API Sitemap: Pure data direct from /webapi/public/api/getSitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 2c. Serve precompressed gzip assets when the browser supports gzip.
# The .gz files are generated at build time, so Apache avoids recompressing them.
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_URI} !\.gz$ [NC]
RewriteCond %{REQUEST_FILENAME}\.gz -s
RewriteRule ^(.+)$ $1.gz [L]

# 2. Enforce NO trailing slash across all URLs (301 redirect trailing slash to non-trailing slash)
RewriteCond %{REQUEST_URI} !^/webapi/ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Serve SSG pre-rendered static HTML if folder/index.html exists
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# 6. Fallback for unrendered SPA routes
RewriteCond %{REQUEST_URI} !^/webapi/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>

# 7. Security Headers & Static asset caching for Apache / cPanel / LiteSpeed
<IfModule mod_headers.c>
    # 1. Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # 2. Enforce HSTS (Strict-Transport-Security for 1 year)
    Header always set Strict-Transport-Security "max-age=31536000"

    # 3. Secure Referrer Policy (protect path leakage to cross-origin destinations)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 4. Prevent MIME-Type Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Hashed Vite bundles are content-addressed, so they can be cached for a year.
    # sw.js / workbox-*.js are excluded here and handled by the revalidate block below.
    <FilesMatch "^(?!sw\.js(\.gz)?$)(?!workbox-).*\.(js|mjs|css|woff2|woff|ttf|otf|eot)(\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Service worker + Workbox runtime must always revalidate after a deploy.
    <FilesMatch "^(sw\.js|workbox-.*\.js)(\.gz)?$">
        Header set Cache-Control "public, no-cache, max-age=0, must-revalidate"
    </FilesMatch>

    # Public images are NOT content-hashed (e.g. /images/hero/*.webp),
    # so 30 days instead of immutable 1 year to avoid stale files after replacement.
    <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico)(\.gz)?$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML/manifest: browsers revalidate, edge/CDN (Cloudflare/nginx/Varnish)
    # may cache for 10 minutes to cut TTFB. X-Accel-Expires is intentionally removed.
    <FilesMatch "\.(html|webmanifest)(\.gz)?$">
        Header set Cache-Control "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        Header unset Pragma
        Header unset Expires
        Header unset X-Accel-Expires
    </FilesMatch>

    # API JSON / sitemap XML must NOT be edge-cached.
    <FilesMatch "\.(json|xml)(\.gz)?$">
        Header set Cache-Control "public, no-cache, max-age=0, must-revalidate"
    </FilesMatch>

    # Precompressed responses still need to vary by Accept-Encoding.
    <FilesMatch "\.(js|mjs|css|html|webmanifest|json|xml|svg)\.gz$">
        Header set Vary "Accept-Encoding"
    </FilesMatch>
</IfModule>

# Fallback for hosts where mod_headers is unavailable.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 8. Compression: Brotli when available, otherwise gzip.
# Fonts (woff/woff2) are already compressed and are intentionally not re-compressed.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule !mod_brotli.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json application/xml application/rss+xml image/svg+xml
    </IfModule>
</IfModule>
